# =============================================================================
# VFI log rotation — the LIVE copy is /etc/logrotate.d/vfi. This is the record.
#
#     sudo cp /var/www/vfi/deploy/logrotate/vfi /etc/logrotate.d/vfi
#     sudo chmod 644 /etc/logrotate.d/vfi
#     sudo logrotate -d /etc/logrotate.d/vfi   # dry run: prints, changes nothing
#
# WHY: nothing rotated these. /etc/logrotate.d/ carried rules for nginx, both
# PHP-FPM pools, postgres, redis and fail2ban — and none for this application.
# A cron entry appends to vfi-schedule.log every minute of every day, so it grows
# without limit; it was 2.6 MB and the deploy log 302 KB when this was written.
# The disk is 25 GB with 18 GB free, so this was not yet urgent, but "not yet"
# is the only thing wrong with it.
#
# copytruncate is deliberate and is the point of this file. cron re-runs the
# command every minute and the shell opens the log with >> each time, but
# php-fpm and the queue worker hold their handles open for much longer. Renaming
# a file out from under an open handle leaves the writer appending to an inode
# nothing can read any more, and the "rotated" log then grows invisibly. Copying
# and truncating in place keeps the handle valid. The cost is a tiny window
# where lines written mid-copy are lost, which for these logs is the right trade.
# =============================================================================

/var/log/vfi-deploy.log
/var/log/vfi-schedule.log
/var/log/vfi-worker.log
{
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su root root

    # 0640 root:adm — readable by the adm group the way the rest of /var/log is,
    # not world-readable. These carry artisan output, which can include a path,
    # a query or an exception message.
    create 0640 root adm
}

# Laravel's own log. Not in the block above because it belongs to www-data and
# lives under the application rather than /var/log, and because the retention is
# deliberately shorter: LOG_LEVEL=warning on this server, so anything in here is
# something that went wrong and should be looked at within a week, not archived
# for a fortnight.
/var/www/vfi/backend/storage/logs/*.log
{
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su www-data www-data
    create 0640 www-data www-data
}
