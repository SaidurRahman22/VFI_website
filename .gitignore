# ===== VFI monorepo root .gitignore =====
# Static site at root, Laravel API under backend/ (has its own .gitignore too).

# ---- secrets / env (NEVER commit) ----
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ---- Laravel: dependencies, build, storage, local db ----
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php
backend/.phpunit.cache/
backend/.phpunit.result.cache

# ---- local databases ----
*.sqlite
*.sqlite-journal
backend/database/*.sqlite

# ---- deploy secrets ----
deploy/nginx/tls/
backend/.env.docker

# ---- node ----
node_modules/

# ---- os / editor ----
.DS_Store
Thumbs.db
*.log
.idea/
