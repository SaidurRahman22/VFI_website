# ===== VFI monorepo root .gitignore =====
# Static site at root, Laravel API under backend/ (has its own .gitignore too).

# ---- secrets / env (NEVER commit) ----
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ---- Laravel: dependencies, build, storage, local db ----
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php
backend/.phpunit.cache/
backend/.phpunit.result.cache

# ---- local databases ----
*.sqlite
*.sqlite-journal
backend/database/*.sqlite

# ---- deploy secrets ----
deploy/nginx/tls/
backend/.env.docker

# ---- node ----
node_modules/

# ---- os / editor ----
.DS_Store
Thumbs.db
*.log
.idea/

# private keys / secrets — NEVER commit
test/id_rsa.ppk
id_rsa
id_rsa.*
*.ppk
*.pem
*.key
test/ui/panel-shots/

# Playwright MCP writes page snapshots/console logs here during verification.
# The repo root is the web root, so build and test output must stay out of it.
#
# CORRECTION to what 26be688 said. That message claimed the three .yml files
# committed in 41e2c36 "were served publicly for a few minutes". They were not:
# nginx on this server refuses dot-paths outright. Measured against the live
# vhost - /university.html is 200 while /.gitignore and /.git/config are both
# 403, and /.git/config is the one that would have mattered. Ignoring this
# directory is still right, because relying on that deny rule to excuse
# committing junk into the web root is not a position worth holding.
.playwright-mcp/
